{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "json", "clear-text", "progress"],
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": ["services/productService.js"],
  "jest": {
    "configFile": "jest.reviewed.config.json",
    "enableFindRelatedTests": false
  },
  "htmlReporter": {
    "fileName": "reports/mutation/reviewed/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/reviewed/mutation.json"
  }
}