
{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "services/productService.js"
  ],
  "jest": {
    "configFile": "jest.own.config.json",
    "enableFindRelatedTests": false
  },
  "htmlReporter": {
    "fileName": "reports/mutation/own/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/own/mutation.json"
  }
}
